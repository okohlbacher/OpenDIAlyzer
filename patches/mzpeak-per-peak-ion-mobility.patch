+/******************************************************************************/
+namespace {
+
+/// Chunk-walking accessor for a flat top-level column: calls @p fn(row_index_in_
+/// file, typed_array, row_in_chunk) for every row, so callers never depend on
+/// chunk boundaries (they differ per column).
+template <typename ArrayT, typename Fn>
+void for_each_row(const std::shared_ptr<arrow::ChunkedArray>& col, Fn&& fn)
+{
+  if (!col) return;
+  int64_t base = 0;
+  for (const auto& chunk : col->chunks()) {
+    auto arr = std::dynamic_pointer_cast<ArrayT>(chunk);
+    if (arr) {
+      for (int64_t r = 0; r < arr->length(); ++r) fn(base + r, *arr, r);
+    }
+    base += chunk->length();
+  }
+}
+
+/// Read a whole numeric column into a dense vector indexed by file row, with a
+/// parallel validity mask. Handles the width the writer actually used.
+template <typename ArrayT, typename V>
+void column_to_vector(const std::shared_ptr<arrow::Table>& t, const char* name,
+                      std::vector<V>& out, std::vector<char>& valid)
+{
+  auto col = t ? t->GetColumnByName(name) : nullptr;
+  if (!col) return;
+  out.assign(static_cast<std::size_t>(col->length()), V{});
+  valid.assign(static_cast<std::size_t>(col->length()), 0);
+  for_each_row<ArrayT>(col, [&](int64_t i, const ArrayT& a, int64_t r) {
+    if (!a.IsNull(r)) { out[static_cast<std::size_t>(i)] = static_cast<V>(a.Value(r));
+                        valid[static_cast<std::size_t>(i)] = 1; }
+  });
+}
+
+} // namespace
+
+/******************************************************************************/
+std::map<uint64_t, SpectrumMetadata>
+read_spectra_metadata_flat(Parquet& metadata, Parquet* scans, Parquet* precursors,
+                           Parquet* selected_ions)
+{
+  std::map<uint64_t, SpectrumMetadata> out;
+  auto table = read_metadata_table(metadata);
+  if (!table) return out;
+
+  // ---- PASS 1: the flat spectrum columns -----------------------------------
+  auto idx_col = table->GetColumnByName("index");
+  if (!idx_col) return out;                       // not the flat layout after all
+  auto id_col       = table->GetColumnByName("id");
+  auto mslevel_col  = table->GetColumnByName("ms_level");
+  auto time_col     = table->GetColumnByName("time");
+  auto pol_col      = table->GetColumnByName("scan_polarity");
+  auto repr_col     = table->GetColumnByName("spectrum_representation");
+  auto stype_col    = table->GetColumnByName("spectrum_type");
+  auto ndp_col      = table->GetColumnByName("number_of_data_points");
+
+  // index -> the SpectrumMetadata being built (join key is the VALUE, not a row)
+  std::vector<uint64_t> row_index;                // file row -> index value
+  for_each_row<arrow::UInt64Array>(idx_col, [&](int64_t, const arrow::UInt64Array& a, int64_t r) {
+    row_index.push_back(a.IsNull(r) ? 0 : a.Value(r));
+  });
+
+  auto str_at = [](const std::shared_ptr<arrow::ChunkedArray>& col, int64_t want) -> std::string {
+    std::string v; int64_t base = 0;
+    if (!col) return v;
+    for (const auto& chunk : col->chunks()) {
+      if (want < base + chunk->length()) {
+        const int64_t r = want - base;
+        if (auto a = std::dynamic_pointer_cast<arrow::LargeStringArray>(chunk))
+          { if (!a->IsNull(r)) v = a->GetString(r); }
+        else if (auto b = std::dynamic_pointer_cast<arrow::StringArray>(chunk))
+          { if (!b->IsNull(r)) v = b->GetString(r); }
+        break;
+      }
+      base += chunk->length();
+    }
+    return v;
+  };
+
+  std::vector<double> ms_v, time_v, pol_v, ndp_v;
+  std::vector<char>   ms_ok, time_ok, pol_ok, ndp_ok;
+  column_to_vector<arrow::UInt8Array, double>(table, "ms_level", ms_v, ms_ok);
+  column_to_vector<arrow::DoubleArray, double>(table, "time", time_v, time_ok);
+  column_to_vector<arrow::Int8Array,  double>(table, "scan_polarity", pol_v, pol_ok);
+  column_to_vector<arrow::UInt64Array, double>(table, "number_of_data_points", ndp_v, ndp_ok);
+
+  for (std::size_t r = 0; r < row_index.size(); ++r) {
+    SpectrumMetadata m;
+    m.index = row_index[r];
+    m.id    = str_at(id_col, static_cast<int64_t>(r));
+    if (r < ms_ok.size()  && ms_ok[r])  m.ms_level = static_cast<int>(ms_v[r]);
+    if (r < pol_ok.size() && pol_ok[r]) m.polarity = static_cast<int>(pol_v[r]);
+    if (r < ndp_ok.size() && ndp_ok[r]) m.number_of_data_points = static_cast<uint64_t>(ndp_v[r]);
+    // `time` is minutes (same convention as the nested layout); scans override below.
+    if (r < time_ok.size() && time_ok[r]) m.retention_time = time_v[r] * 60.0;
+    m.representation = str_at(repr_col, static_cast<int64_t>(r));
+    m.spectrum_type  = str_at(stype_col, static_cast<int64_t>(r));
+    out[m.index] = std::move(m);
+  }
+
+  // ---- PASS 2: scans side table -> retention time + ion mobility ------------
+  if (scans) {
+    auto st = read_metadata_table(*scans);
+    if (st) {
+      std::vector<double> src, rt, im;
+      std::vector<char> src_ok, rt_ok, im_ok;
+      column_to_vector<arrow::UInt64Array, double>(st, "source_index", src, src_ok);
+      column_to_vector<arrow::FloatArray,  double>(st, "scan_start_time", rt, rt_ok);
+      column_to_vector<arrow::DoubleArray, double>(st, "ion_mobility_value", im, im_ok);
+      auto imtype = st->GetColumnByName("ion_mobility_type");
+      for (std::size_t r = 0; r < src_ok.size(); ++r) {
+        if (!src_ok[r]) continue;
+        auto it = out.find(static_cast<uint64_t>(src[r]));
+        if (it == out.end()) continue;            // unmatched source_index: skip, no silent merge
+        // scan_start_time is minutes (UO_0000031), like the nested layout.
+        if (r < rt_ok.size() && rt_ok[r]) it->second.retention_time = rt[r] * 60.0;
+        if (r < im_ok.size() && im_ok[r]) {
+          it->second.ion_mobility = im[r];
+          it->second.ion_mobility_type = str_at(imtype, static_cast<int64_t>(r));
+        }
+      }
+    }
+  }
+
+  // ---- PASS 3: precursors side table -> isolation windows ------------------
+  if (precursors) {
+    auto pt = read_metadata_table(*precursors);
+    if (pt) {
+      std::vector<double> src; std::vector<char> src_ok;
+      column_to_vector<arrow::UInt64Array, double>(pt, "source_index", src, src_ok);
+      auto iso_col = pt->GetColumnByName("isolation_window");
+      // isolation_window is a struct<isolation_window_target, _lower_offset,
+      // _upper_offset, parameters>; walk it in file-row order to stay aligned
+      // with source_index.
+      std::vector<double> tgt, lo, hi; std::vector<char> tgt_ok, lo_ok, hi_ok;
+      if (iso_col) {
+        const int64_t n = iso_col->length();
+        tgt.assign(n, 0); lo.assign(n, 0); hi.assign(n, 0);
+        tgt_ok.assign(n, 0); lo_ok.assign(n, 0); hi_ok.assign(n, 0);
+        int64_t base = 0;
+        for (const auto& chunk : iso_col->chunks()) {
+          auto st_arr = std::dynamic_pointer_cast<arrow::StructArray>(chunk);
+          if (st_arr) {
+            auto f_t = std::dynamic_pointer_cast<arrow::FloatArray>(st_arr->GetFieldByName("isolation_window_target"));
+            auto f_l = std::dynamic_pointer_cast<arrow::FloatArray>(st_arr->GetFieldByName("isolation_window_lower_offset"));
+            auto f_u = std::dynamic_pointer_cast<arrow::FloatArray>(st_arr->GetFieldByName("isolation_window_upper_offset"));
+            for (int64_t r = 0; r < st_arr->length(); ++r) {
+              const std::size_t i = static_cast<std::size_t>(base + r);
+              if (st_arr->IsNull(r)) continue;
+              if (f_t && !f_t->IsNull(r)) { tgt[i] = f_t->Value(r); tgt_ok[i] = 1; }
+              if (f_l && !f_l->IsNull(r)) { lo[i]  = f_l->Value(r); lo_ok[i]  = 1; }
+              if (f_u && !f_u->IsNull(r)) { hi[i]  = f_u->Value(r); hi_ok[i]  = 1; }
+            }
+          }
+          base += chunk->length();
+        }
+      }
+      // ---- PASS 4: selected_ions side table ---------------------------------
+      // Carries each isolation window's ion_mobility_value -- for diaPASEF this is
+      // the mobility MIDPOINT of the window's scan range, and it is the only thing
+      // that distinguishes the N windows a single frame carries. Without it every
+      // window of a frame looks identical in mobility and half of them are lost.
+      //
+      // Both side tables leave precursor_index NULL, so the pairing has to be
+      // POSITIONAL (row r of precursors <-> row r of selected_ions). That is only
+      // valid if the two tables agree row-for-row, so verify it instead of
+      // assuming, and skip the attach entirely if they do not.
+      std::vector<double> si_src, si_im, si_mz, si_int, si_lo, si_hi;
+      std::vector<char> si_src_ok, si_im_ok, si_mz_ok, si_int_ok, si_lo_ok, si_hi_ok;
+      std::shared_ptr<arrow::Table> sit;
+      if (selected_ions) {
+        sit = read_metadata_table(*selected_ions);
+        if (sit) {
+          column_to_vector<arrow::UInt64Array, double>(sit, "source_index", si_src, si_src_ok);
+          column_to_vector<arrow::DoubleArray, double>(sit, "ion_mobility_value", si_im, si_im_ok);
+          column_to_vector<arrow::DoubleArray, double>(sit, "selected_ion_mz", si_mz, si_mz_ok);
+          column_to_vector<arrow::FloatArray,  double>(sit, "peak_intensity", si_int, si_int_ok);
+
+          // The isolation window's mobility BOUNDS ride in the selected-ion `parameters`
+          // list, matched by name: PSI-MS has no term for them, and a non-standard
+          // accession cannot be encoded (mzdata panics on unknown CVs), so the writer
+          // emits them name-only.
+          auto par_col = sit->GetColumnByName("parameters");
+          if (par_col) {
+            si_lo.assign(par_col->length(), 0.0); si_lo_ok.assign(par_col->length(), 0);
+            si_hi.assign(par_col->length(), 0.0); si_hi_ok.assign(par_col->length(), 0);
+            int64_t base = 0;
+            for (const auto& chunk : par_col->chunks()) {
+              auto lst = std::dynamic_pointer_cast<arrow::LargeListArray>(chunk);
+              if (!lst) { base += chunk->length(); continue; }
+              auto items = std::dynamic_pointer_cast<arrow::StructArray>(lst->values());
+              if (!items) { base += chunk->length(); continue; }
+              auto nm = std::dynamic_pointer_cast<arrow::LargeStringArray>(items->GetFieldByName("name"));
+              auto val = std::dynamic_pointer_cast<arrow::StructArray>(items->GetFieldByName("value"));
+              auto fl = val ? std::dynamic_pointer_cast<arrow::DoubleArray>(val->GetFieldByName("float")) : nullptr;
+              if (!nm || !fl) { base += chunk->length(); continue; }
+              for (int64_t r = 0; r < lst->length(); ++r) {
+                if (lst->IsNull(r)) continue;
+                const std::size_t row = static_cast<std::size_t>(base + r);
+                for (int64_t k = lst->value_offset(r); k < lst->value_offset(r + 1); ++k) {
+                  if (nm->IsNull(k) || fl->IsNull(k)) continue;
+                  const std::string_view n = nm->GetView(k);
+                  if (n.find("ion mobility lower limit") != std::string_view::npos) {
+                    si_lo[row] = fl->Value(k); si_lo_ok[row] = 1;
+                  } else if (n.find("ion mobility upper limit") != std::string_view::npos) {
+                    si_hi[row] = fl->Value(k); si_hi_ok[row] = 1;
+                  }
+                }
+              }
+              base += chunk->length();
+            }
+          }
+        }
+      }
+      bool aligned = !si_src.empty() && si_src.size() == src.size();
+      for (std::size_t r = 0; aligned && r < src.size(); ++r) {
+        if (src_ok[r] != si_src_ok[r] || (src_ok[r] && src[r] != si_src[r])) aligned = false;
+      }
+      if (!si_src.empty() && !aligned) {
+        std::fprintf(stderr,
+                     "mzpeak: selected_ions does not align row-for-row with precursors "
+                     "(%zu vs %zu rows); ion mobility per isolation window not attached\n",
+                     si_src.size(), src.size());
+      }
+
+      for (std::size_t r = 0; r < src_ok.size(); ++r) {
+        if (!src_ok[r]) continue;
+        auto it = out.find(static_cast<uint64_t>(src[r]));
+        if (it == out.end()) continue;
+        PrecursorInfo pi;
+        if (r < tgt_ok.size() && tgt_ok[r]) pi.isolation_window.target_mz = static_cast<float>(tgt[r]);
+        if (r < lo_ok.size()  && lo_ok[r])  pi.isolation_window.lower_offset = static_cast<float>(lo[r]);
+        if (r < hi_ok.size()  && hi_ok[r])  pi.isolation_window.upper_offset = static_cast<float>(hi[r]);
+        if (aligned) {
+          SelectedIonInfo ion;
+          if (r < si_mz_ok.size()  && si_mz_ok[r])  ion.selected_ion_mz = si_mz[r];
+          if (r < si_int_ok.size() && si_int_ok[r]) ion.intensity = static_cast<float>(si_int[r]);
+          if (r < si_im_ok.size()  && si_im_ok[r])  ion.ion_mobility_value = si_im[r];
+          if (r < si_lo_ok.size()  && si_lo_ok[r])  ion.ion_mobility_lower_limit = si_lo[r];
+          if (r < si_hi_ok.size()  && si_hi_ok[r])  ion.ion_mobility_upper_limit = si_hi[r];
+          if (ion.selected_ion_mz || ion.ion_mobility_value) pi.selected_ions.push_back(std::move(ion));
+        }
+        it->second.precursors.push_back(std::move(pi));
+      }
+    }
+  }
+
+  return out;
+}
+
 /******************************************************************************/
 std::map<uint64_t, SpectrumMetadata> read_spectra_metadata(Parquet& metadata)
 {
