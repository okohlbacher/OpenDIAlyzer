+  std::shared_ptr<arrow::Array> ParquetFile::ChunkedColumn::resolve(int64_t row, int64_t& local) const
+  {
+    if (!col_ || row < 0 || row >= col_->length()) { return nullptr; }
+    const int n = col_->num_chunks();
+    // Rewind if the caller jumped backwards past the cached chunk.
+    if (row < base_) { cur_ = 0; base_ = 0; }
+    // Walk forward. Sequential scans advance at most one chunk per call, so this is O(1) amortised.
+    while (cur_ < n && row >= base_ + col_->chunk(cur_)->length())
+    {
+      base_ += col_->chunk(cur_)->length();
+      ++cur_;
+    }
+    if (cur_ >= n) { return nullptr; }
+    local = row - base_;
+    return col_->chunk(cur_);
+  }
