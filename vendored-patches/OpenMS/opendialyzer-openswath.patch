 // OpenSwathWorkflow
+namespace
+{
+  // Region accounting INSIDE performExtraction. This phase is 65% of wall and 90% of CPU
+  // (48,120 CPU-s measured) and has never been broken down: perf is blocked by
+  // perf_event_paranoid=4 and gdb by ptrace_scope on the benchmark nodes, so an external profiler
+  // is not available. Without this, every proposal about extraction is a guess -- and guessing at
+  // this black box is exactly what made -readOptions cacheWorkingInMemory raise occupancy from
+  // 38.9 to 97.8 cores while COSTING 2.4x the CPU.
+  //
+  // Thread-seconds, summed across the parallel loop, so the totals are directly comparable with
+  // the process CPU-seconds the phase timers report.
+  struct RegionAcc
+  {
+    std::atomic<double> secs{0.0};
+    std::atomic<long long> calls{0};
+    void add(double s) noexcept
+    {
+      double cur = secs.load(std::memory_order_relaxed);
+      while (!secs.compare_exchange_weak(cur, cur + s, std::memory_order_relaxed)) {}
+      calls.fetch_add(1, std::memory_order_relaxed);
+    }
+  };
+  RegionAcc g_rgn_extract, g_rgn_convert, g_rgn_score, g_rgn_write, g_rgn_ms1;
+
+  struct ScopedRegion
+  {
+    RegionAcc& acc;
+    std::chrono::steady_clock::time_point t0;
+    explicit ScopedRegion(RegionAcc& a) : acc(a), t0(std::chrono::steady_clock::now()) {}
+    ~ScopedRegion() { acc.add(std::chrono::duration<double>(std::chrono::steady_clock::now() - t0).count()); }
+  };
+
+  void reportRegions_(const char* where)
+  {
+    const double e = g_rgn_extract.secs.load(), c = g_rgn_convert.secs.load();
+    const double s = g_rgn_score.secs.load(), w = g_rgn_write.secs.load(), m = g_rgn_ms1.secs.load();
+    const double tot = e + c + s + w + m;
+    OPENMS_LOG_INFO << "OpenSwathWorkflow[region] " << where << " thread-seconds: "
+                    << "extractChromatograms " << e << " (" << g_rgn_extract.calls.load() << " calls), "
+                    << "return_chromatogram " << c << ", "
+                    << "scoreAllChromatograms " << s << ", "
+                    << "writeOutFeatures " << w << ", "
+                    << "MS1Extraction " << m << "; accounted " << tot << std::endl;
+  }
+}
+
