+    std::pair<int, double> normalizedCrossCorrelationMaxPost(
+        const std::vector<double>& normalized_data1, const std::vector<double>& normalized_data2,
+        const int maxdelay, const int lag)
+    {
+      OPENSWATH_PRECONDITION(normalized_data1.size() == normalized_data2.size(),
+                             "Both data vectors need to have the same length");
+
+      // Same loop as calculateCrossCorrelation + the /size() of normalizedCrossCorrelationPost +
+      // the scan of xcorrArrayGetMaxPeak, fused. The division is applied to the running best rather
+      // than to every element, which is also why nothing is stored.
+      const int datasize = static_cast<int>(normalized_data1.size());
+      const double* __restrict d1 = normalized_data1.data();
+      const double* __restrict d2 = normalized_data2.data();
+
+      int best_delay = -maxdelay;
+      double best = -std::numeric_limits<double>::max();
+      bool have = false;
+
+      for (int delay = -maxdelay; delay <= maxdelay; delay += lag)
+      {
+        const int start = std::max(0, -delay);
+        const int end = std::min(datasize, datasize - delay);
+        const int len = end - start;
+
+        double sxy = 0.0;
+        if (len > 0)
+        {
+          Eigen::Map<const Eigen::VectorXd> sub1(d1 + start, len);
+          Eigen::Map<const Eigen::VectorXd> sub2(d2 + start + delay, len);
+          sxy = sub1.dot(sub2);
+        }
+        // Strict >, matching xcorrArrayGetMaxPeak, which keeps the FIRST maximum it meets while
+        // walking from -maxdelay upward. A >= here would silently change the reported delay on ties
+        // and with it the coelution score.
+        if (!have || sxy > best)
+        {
+          have = true;
+          best = sxy;
+          best_delay = delay;
+        }
+      }
+      if (datasize == 0) { return {0, 0.0}; }
+      return {best_delay, best / static_cast<double>(datasize)};
+    }
